{
  "name": "video-similarity-desktop",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:css": "node scripts/check-css-duplicates.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "visual:qa": "node scripts/visual-qa.mjs --mock-tauri",
    "visual:qa:merge": "node scripts/visual-qa.mjs --mock-tauri --route merge",
    "visual:qa:real": "node scripts/visual-qa.mjs --real-tauri",
    "tauri": "npx tauri",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-windows.ps1",
    "build:windows:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-windows.ps1 -GpuBuild",
    "build:macos": "bash ./build-macos.sh",
    "build:linux": "bash ./build-linux.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.479.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.18.1",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.4.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  }
}
